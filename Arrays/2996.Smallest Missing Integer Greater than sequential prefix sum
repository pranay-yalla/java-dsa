class Solution {
    public int missingInteger(int[] nums) {
      int sum=nums[0];
      int i=0;
      for(i=1;i<nums.length;i++) 
      {
          if(nums[i]==nums[i-1]+1)
          {
              sum+=nums[i];
              
          }
          else
          {
              break;
          }
      }
      HashSet<Integer> set=new HashSet<>() ;
      set.add(nums[0]);
      for(;i<nums.length;i++) 
      {
          set.add(nums[i]);
      }
      while(true)
      {
          if(set.contains(sum))
          {
              sum++;
          }
          else
          return sum;
      }
    }
}
