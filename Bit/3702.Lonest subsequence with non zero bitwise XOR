class Solution {
    public int longestSubsequence(int[] nums) {
       int zeroCount=0,xorResult=0;
       for(int i=0;i<nums.length;i++) 
       {
           xorResult^=nums[i];
           if(nums[i]==0)
           zeroCount++;
       }
       if(zeroCount==nums.length)
       return 0;
       if(xorResult!=0)
       return nums.length;
       else
       return nums.length-1;
    }
}
